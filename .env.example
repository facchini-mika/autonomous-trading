# Local-dev placeholders. Copy to .env (gitignored) and adjust passwords.
# Production: source from systemd EnvironmentFile or Docker secret instead.

# Owner connection (used by Alembic migrations and bootstrap only).
DATABASE_URL=postgresql+psycopg://postgres@localhost:5432/autonomous_trading

# Per-role connections (used by cron-driven processes).
DATABASE_URL_TRADING_CYCLE=postgresql+psycopg://trading_cycle:dev_trading_cycle@localhost:5432/autonomous_trading
DATABASE_URL_OUTCOME_INGESTION=postgresql+psycopg://outcome_ingestion:dev_outcome_ingestion@localhost:5432/autonomous_trading
DATABASE_URL_LESSONS_SUMMARY=postgresql+psycopg://lessons_summary:dev_lessons_summary@localhost:5432/autonomous_trading

# Container env (used by docker-compose to seed app-role passwords).
PGPASSWORD_TRADING_CYCLE=dev_trading_cycle
PGPASSWORD_OUTCOME_INGESTION=dev_outcome_ingestion
PGPASSWORD_LESSONS_SUMMARY=dev_lessons_summary
