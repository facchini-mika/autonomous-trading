# Copy to .env and fill in real values. .env is gitignored.

# --- Database / Cache ---
POSTGRES_USER=trading
POSTGRES_PASSWORD=trading_dev
POSTGRES_DB=autonomous_trading
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://trading:trading_dev@localhost:5432/autonomous_trading

REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- LLM providers ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Polymarket ---
POLYMARKET_CLOB_BASE=https://clob.polymarket.com
POLYMARKET_GAMMA_BASE=https://gamma-api.polymarket.com

# --- Modes ---
# paper | real_capital   (per engineering.md §11; never set real_capital outside a settings-file PR)
TRADING_MODE=paper

# --- Misc ---
LOG_LEVEL=INFO
